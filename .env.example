# Copy to .env.local in this folder (repo root) and fill in values.
# Supabase: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — required for spotify_cache and cron cleanup
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron → GET /api/cron/cleanup-cache (Authorization: Bearer <secret>)
CRON_SECRET=

# Required for refreshing Spotify user tokens (playback, playlists, etc.)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local dev (share links, meta — NOT used for OAuth redirectTo):
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://musicator.app

# Jams / Jukebox / WAM playback (off by default — Step 0 legacy-only):
# NEXT_PUBLIC_LIVE_ADVANCED_MODES=true

# Set to true to stop /api/spotify/playback polling (Player uses Web Playback SDK only).
# NEXT_PUBLIC_DISABLE_PLAYBACK_POLLING=true

# Optional: enable /api/audit in production (send header x-audit-secret with same value).
# AUDIT_SECRET=

# Dev: Test WAM is auto-enabled when NODE_ENV=development (npm run dev).
# Force in production builds: NEXT_PUBLIC_LIVE_SIMULATE=true
# Optional gate for /api/dev/live/* in production: DEV_LIVE_SECRET + header x-dev-live-secret
# Required for smoke/e2e/perf against https://musicator.app or `npm run start` locally:
# DEV_LIVE_SECRET=
#
# Target URL for smoke, e2e, and perf scripts (default http://localhost:3000):
# SMOKE_BASE_URL=https://musicator.app
# Playwright only — command when testing local prod build (default npm run dev):
# SMOKE_WEB_SERVER=npm run start
# Password for wam-test-*@musicator.dev (default wam-dev-test-12!): WAM_TEST_USER_PASSWORD=
#
# Optional — give test user Spotify playback in smoke/e2e (dev only, never commit):
# 1. Log in to Musicator with Spotify in the browser.
# 2. Copy your Spotify refresh token into .env.local (see test-playlist.mjs header or Supabase session).
# WAM_TEST_SPOTIFY_REFRESH_TOKEN=
# Alias also works: TEST_SPOTIFY_PROVIDER_REFRESH_TOKEN=
# Then run: npm run link-test-spotify  (or POST /api/dev/smoke/login links automatically)

# Supabase Dashboard → Authentication → URL Configuration (required for production login):
#   Site URL: https://musicator.app
#   Redirect URLs (add all):
#     https://musicator.app/auth/callback
#     http://localhost:3000/auth/callback
#
# Supabase Dashboard → Authentication → Providers → Spotify:
# Use the SAME Client ID/Secret as below. Optional extra scopes field (comma-separated):
# user-read-private,user-read-email,playlist-read-private,playlist-modify-public,playlist-modify-private,streaming,user-read-playback-state,user-modify-playback-state,user-read-currently-playing
#
# Spotify Dashboard → Redirect URI:
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#
# Development mode: add each user's Spotify email under User Management.
