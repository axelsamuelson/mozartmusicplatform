# Copy to .env.local in this folder (repo root) and fill in values.
# Supabase: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (optional locally unless you use service-role routes)
SUPABASE_SERVICE_ROLE_KEY=

# Required for refreshing Spotify user tokens (playback, playlists, etc.)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Emergency brake: set to true in Vercel to stop GET /api/spotify/playback polling
NEXT_PUBLIC_DISABLE_PLAYBACK_POLLING=false
